node_modules/
dist/
dist-perf/
.shots/
# Measurements, but NOT .perf/baseline.json — see the negation below. A baseline
# is a claim about how fast this game is, and a claim like that belongs in the
# history next to the code it describes; everything else in here is one run's
# working out.
.perf/*
!.perf/baseline.json
.vite.log
*.local

# The TURN API token lives here. It is long-lived and can mint unlimited relay
# credentials on your account, so it must never be committed — see .env.example,
# which is the file that IS committed.
.env
.env.*
!.env.example

# The ambience beds. Generated, or licensed from somewhere else — either way not
# ours to commit. `scripts/audio-bed-make.mjs` writes a synthesised placeholder
# here so the player can be tested without licensing anything, and a real bed
# would be a third-party recording with its own terms. `AmbienceBed.load` returns
# null when this directory is absent, which is what keeps a stock checkout
# measuring exactly the forest every script in scripts/ was calibrated against.
public/audio/beds/
